# ==============================================================================
# WiFiSense 3D Platform - Environment Configuration Template
# ==============================================================================

# Application & Environment
APP_ENV=development
APP_NAME="WiFiSense 3D"
APP_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-key-32-bytes
DEBUG=True
API_V1_STR="/api/v1"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000/ws/telemetry"
VITE_ENABLE_SIMULATION=true
VITE_DEFAULT_BUILDING_ID="hostel-block-a"

# Database Configuration (PostgreSQL with PostGIS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wifisense
POSTGRES_PASSWORD=wifisense_secure_pass
POSTGRES_DB=wifisense_db
DATABASE_URL=postgresql+asyncpg://wifisense:wifisense_secure_pass@localhost:5432/wifisense_db

# Redis Broker & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Keycloak / OIDC Authentication
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=wifisense-realm
KEYCLOAK_CLIENT_ID=wifisense-frontend
KEYCLOAK_CLIENT_SECRET=change-this-keycloak-client-secret

# Telemetry & Hardware Adapters
DEFAULT_TELEMETRY_MODE=SIMULATION # Options: SIMULATION, LIVE_DECO, ESP32_CSI
DECO_ROUTER_IP=192.168.68.1
ESP32_CSI_SERIAL_PORT=COM3
ESP32_CSI_BAUDRATE=921600

# Privacy & DPDP Compliance
DATA_RETENTION_DAYS_PARTICIPANT=30
ANONYMOUS_OCCUPANCY_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365

